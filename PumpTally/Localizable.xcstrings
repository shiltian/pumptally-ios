    },
    "This change uses an unsupported format. Update PumpTally before trying again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio usa un formato no compatible. Actualiza PumpTally antes de volver a intentarlo."
