      }
    },
    "This action cannot be undone. All your data will be permanently deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer. Todos tus datos se eliminarán permanentemente."
