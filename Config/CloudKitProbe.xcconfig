// Separate app and development container; never used by the PumpTally scheme.
// The live suite accepts only this isolated development container.
CLOUDKIT_TEST_CONTAINER_IDENTIFIER = iCloud.me.tianshilei.fuelio.CloudKitProbe
CODE_SIGN_ENTITLEMENTS = CloudKitProtocolTests/Probe.entitlements
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = F9M3UZ669L
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = CloudKitProtocolTests/Probe-Info.plist
IPHONEOS_DEPLOYMENT_TARGET = 17.0
PRODUCT_BUNDLE_IDENTIFIER = me.tianshilei.fuelio.CloudKitProbe
PRODUCT_NAME = $(TARGET_NAME)
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
